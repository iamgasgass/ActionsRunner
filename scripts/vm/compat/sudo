#!/bin/sh
# Nella VM si è già root: sudo esegue direttamente il comando (opzioni comuni ignorate).
while [ $# -gt 0 ]; do
  case "$1" in
    -E|-H|-n|-S|-i|-s|--preserve-env|--preserve-env=*) shift ;;
    -u) shift 2 ;;
    --) shift; break ;;
    *) break ;;
  esac
done
[ $# -eq 0 ] && exit 0
exec "$@"
